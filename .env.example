# Copy this file to .env and fill one value locally. Never commit .env.
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

# Configure exactly one provider. TYPESAFE_API_KEY uses the official
# https://api.typesafe.ai endpoint with model jev-latest. AI_GATEWAY_API_KEY
# uses the Vercel AI Gateway compatibility endpoint with typesafe-ai/jev.
