{
  "schema_version": 1,
  "planner_role": "Jev may select actions and arguments; deterministic code owns motion execution.",
  "actions": [
    {
      "name": "search_object",
      "description": "Move only robot-mounted sensors through a bounded search and return a perceived target.",
      "implementation": "actions/search_object.py",
      "inputs": {
        "target_label": "string",
        "search_scope": "current_view|narrow|wide"
      },
      "outputs": {"observation": "ObjectObservation"},
      "preconditions": ["robot-mounted perception available"]
    },
    {
      "name": "adjust_end_effector",
      "description": "Apply one bounded Cartesian translation/rotation adjustment through the motion planner.",
      "implementation": "actions/adjust_end_effector.py",
      "inputs": {
        "frame": "tool|end_effector|robot_base|target_object",
        "translation_axis": "none|x|y|z",
        "translation_direction": "none|positive|negative",
        "translation_step_m": "0|0.001|0.003|0.005|0.010|0.025",
        "rotation_axis": "none|roll|pitch|yaw",
        "rotation_direction": "none|clockwise|counterclockwise",
        "rotation_step_deg": "0|1|3|5|15",
        "speed_profile": "guarded|slow|normal",
        "stop_condition": "visual_goal|contact|force_limit|path_complete|user_stop"
      },
      "outputs": {"result": "ActionResult"},
      "preconditions": ["motion planner available", "bounded workspace validated"]
    },
    {
      "name": "adjust_gripper",
      "description": "Adjust gripper aperture by a bounded per-finger increment with a stop condition.",
      "implementation": "actions/adjust_gripper.py",
      "inputs": {
        "command": "hold|open|close|widen|narrow",
        "step_m": "0|0.0005|0.001|0.002|0.005",
        "stop_condition": "position_reached|contact|force_limit|visual_goal|user_stop"
      },
      "outputs": {"result": "ActionResult"},
      "preconditions": ["gripper state available"]
    },
    {
      "name": "execute_tool_motion",
      "description": "Execute a bounded tool-relative hold, line, arc, or circular stirring path.",
      "implementation": "actions/execute_tool_motion.py",
      "inputs": {
        "primitive": "hold|linear|arc|circle",
        "frame": "tool|end_effector|robot_base|target_object",
        "plane": "xy|xz|yz",
        "direction": "none|clockwise|counterclockwise",
        "radius_m": "0|0.003|0.005|0.010|0.020|0.030",
        "revolutions": "0|0.25|0.5|1|2|3",
        "axial_step_m": "0|0.001|0.003|0.005|0.010",
        "speed_profile": "guarded|slow|normal",
        "stop_condition": "visual_goal|contact|force_limit|path_complete|user_stop"
      },
      "outputs": {"result": "ActionResult"},
      "preconditions": ["tool grasped", "workspace and path validated"]
    },
    {
      "name": "observe_object",
      "description": "Observe and localize a target using robot-mounted perception.",
      "implementation": "actions/observe_object.py",
      "inputs": {"target_label": "string"},
      "outputs": {"observation": "ObjectObservation"},
      "side_effect": "none"
    },
    {
      "name": "pick_object",
      "description": "Pick a previously observed and validated target.",
      "implementation": "actions/pick_object.py",
      "inputs": {"observation": "ObjectObservation"},
      "outputs": {"result": "ActionResult"},
      "preconditions": ["fresh observation", "reachable pose", "gripper empty"]
    },
    {
      "name": "place_object",
      "description": "Place the held object at a validated destination.",
      "implementation": "actions/place_object.py",
      "inputs": {"destination": "Pose3D"},
      "outputs": {"result": "ActionResult"},
      "preconditions": ["object held", "destination reachable"]
    },
    {
      "name": "verify_transfer",
      "description": "Use robot-mounted perception to verify that the requested transfer is satisfied.",
      "implementation": "actions/verify_transfer.py",
      "inputs": {"observation": "ObjectObservation", "destination": "Pose3D"},
      "outputs": {"result": "ActionResult"},
      "side_effect": "none"
    }
  ]
}
